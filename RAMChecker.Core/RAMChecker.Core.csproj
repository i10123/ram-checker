<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>RAMChecker</RootNamespace>
        <!-- Буфер проверки выделяется вне сборщика мусора через указатели, вызовы Win32 генерируются через LibraryImport. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="PDFsharp-MigraDoc-WPF" Version="6.2.4" />
      <!-- PDFsharp 6.2.4 подтягивает 8.0.1, где есть опубликованные уязвимости. -->
      <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    </ItemGroup>
</Project>
