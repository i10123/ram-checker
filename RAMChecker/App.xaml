<Application x:Class="RAMChecker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ThemeMode="Dark">
    <!-- Цвета берутся из встроенной тёмной темы Fluent, поэтому собственные словари цветов не нужны. -->
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="Vidimost" />

        <Style x:Key="Kartochka" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,16,16" />
        </Style>

        <Style x:Key="Zagolovok" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="Podzagolovok" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Podpis" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Chislo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Значок статуса проверки по уровню Uroven: 0 — не завершена, 1 — без ошибок, 2 — есть ошибки. -->
        <Style x:Key="ZnachokStatusa" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Text" Value="&#xE7BA;" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Uroven}" Value="1">
                    <Setter Property="Text" Value="&#xE73E;" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Uroven}" Value="2">
                    <Setter Property="Text" Value="&#xEA39;" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Таблица «характеристика — значение» для паспорта модуля. -->
        <DataTemplate x:Key="StrokaTablicy">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Podpis}" Text="{Binding Key}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <!-- График загрузки памяти (данные — ObzorViewModel): сетка, заливка под линией и сама линия. -->
        <DataTemplate x:Key="GrafikZagruzki">
            <Viewbox Stretch="Fill">
                <Canvas Width="600" Height="160" ClipToBounds="True">
                    <Line X1="0" Y1="1" X2="600" Y2="1" Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Line X1="0" Y1="40" X2="600" Y2="40" Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" StrokeDashArray="3 5" />
                    <Line X1="0" Y1="80" X2="600" Y2="80" Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" StrokeDashArray="3 5" />
                    <Line X1="0" Y1="120" X2="600" Y2="120" Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" StrokeDashArray="3 5" />
                    <Line X1="0" Y1="159" X2="600" Y2="159" Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" />
                    <Polygon Points="{Binding UsageArea}" Fill="{DynamicResource AccentFillColorDefaultBrush}">
                        <Polygon.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#70000000" Offset="0" />
                                <GradientStop Color="#08000000" Offset="1" />
                            </LinearGradientBrush>
                        </Polygon.OpacityMask>
                    </Polygon>
                    <Polyline Points="{Binding UsagePoints}" Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                              StrokeThickness="2" StrokeLineJoin="Round" />
                </Canvas>
            </Viewbox>
        </DataTemplate>

        <!-- Карта памяти: 256 клеток, по одной на блок буфера. 0 — не проверен, 1 — без ошибок, 2 — ошибка, 3 — ждёт текущего прохода. -->
        <Style x:Key="KartaPamyati" TargetType="ItemsControl">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="32" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border x:Name="Kletka" Height="14" Margin="1.5" CornerRadius="3" ToolTip="{Binding Tip}"
                                Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="1">
                                <Setter TargetName="Kletka" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="3">
                                <Setter TargetName="Kletka" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Setter TargetName="Kletka" Property="Opacity" Value="0.35" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="2">
                                <Setter TargetName="Kletka" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
