<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AssemblyName>RAMChecker</AssemblyName>
        <RootNamespace>RAMChecker</RootNamespace>
        <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
        <!-- Буфер проверки выделяется вне сборщика мусора через указатели. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Тема Fluent встроена в WPF, но помечена как предварительная. -->
        <NoWarn>$(NoWarn);WPF0001</NoWarn>
        <!-- Экономия памяти: сборка мусора без фонового потока и с более частым сжатием кучи. -->
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
        <TieredPGO>false</TieredPGO>
    </PropertyGroup>
    <ItemGroup>
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="System.Management" Version="10.0.12" />
        <!-- Подписанные модули драйвера PawnIO для шины SMBus (AMD и Intel). -->
        <EmbeddedResource Include="Drivers\*.bin" />
        <Resource Include="Assets\logo.ico" />
    </ItemGroup>
</Project>
