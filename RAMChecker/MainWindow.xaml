<Window x:Class="RAMChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RAMChecker.ViewModels"
        Title="RAM Checker" Height="600" Width="1200">
    <!-- ViewModel предоставляет окну данные для привязки. -->
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Таблица показывает свойства каждого модуля памяти. -->
        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding ModulesMemory}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Объём, ГБ" Binding="{Binding size_GB}" />
                <DataGridTextColumn Header="Производитель" Binding="{Binding maker}" />
                <!-- Частота и эффективная скорость передачи отображаются в отдельных столбцах. -->
                <DataGridTextColumn Header="Частота, МГц" Binding="{Binding RAM_frequency_MHz}" />
                <DataGridTextColumn Header="Скорость, MT/s" Binding="{Binding RAM_speed_MT_s}" />
                <DataGridTextColumn Header="Тип памяти" Binding="{Binding RAM_type}" />
                <DataGridTextColumn Header="Форм-фактор" Binding="{Binding RAM_formFactor}" />
                <DataGridTextColumn Header="Напряжение, В" Binding="{Binding RAM_voltage_V}" />
                <DataGridTextColumn Header="Ширина данных, бит" Binding="{Binding RAM_dataWidth_bits}" />
                <DataGridTextColumn Header="Полная ширина, бит" Binding="{Binding RAM_totalWidth_bits}" />
                <!-- WMI пока не предоставляет значения таймингов CL, tRCD, tRP и tRAS. -->
                <DataGridTextColumn Header="CL" Binding="{Binding RAM_CL}" />
                <DataGridTextColumn Header="tRCD" Binding="{Binding RAM_tRCD}" />
                <DataGridTextColumn Header="tRP" Binding="{Binding RAM_tRP}" />
                <DataGridTextColumn Header="tRAS" Binding="{Binding RAM_tRAS}" />
                <DataGridTextColumn Header="Номер детали" Binding="{Binding RAM_partNumber}" />
                <DataGridTextColumn Header="Расположение" Binding="{Binding RAM_deviceLocator}" />
                <DataGridTextColumn Header="Банк" Binding="{Binding RAM_bankLabel}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Показывает сообщение, если сведения не удалось получить. -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <!-- Кнопка появляется только после ошибки доступа к WMI. -->
            <Button Content="Перезапустить от имени администратора"
                    Command="{Binding RestartAsAdminCommand}"
                    HorizontalAlignment="Left">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowAdminButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
