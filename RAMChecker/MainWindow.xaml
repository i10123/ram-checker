<Window x:Class="RAMChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RAMChecker.ViewModels"
        Title="RAM Checker" Height="450" Width="800">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <DataGrid ItemsSource="{Binding ModulesMemory}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Объём, ГБ" Binding="{Binding size_GB}" />
                <DataGridTextColumn Header="Производитель" Binding="{Binding maker}" />
                <DataGridTextColumn Header="Частота, МГц" Binding="{Binding RAM_frequency_MHz}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
