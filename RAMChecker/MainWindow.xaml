<Window x:Class="RAMChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RAMChecker.ViewModels"
        Title="RAM Checker" Height="450" Width="800">
    <!-- ViewModel предоставляет окну данные для привязки. -->
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Таблица показывает свойства каждого модуля памяти. -->
        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding ModulesMemory}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Объём, ГБ" Binding="{Binding size_GB}" />
                <DataGridTextColumn Header="Производитель" Binding="{Binding maker}" />
                <!-- Указывает частоту тактов и скорость передачи данных DDR. -->
                <DataGridTextColumn Header="Частота / скорость передачи" Binding="{Binding RAM_frequency_MHz}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Показывает сообщение, если сведения не удалось получить. -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <!-- Кнопка появляется только после ошибки доступа к WMI. -->
            <Button Content="Перезапустить от имени администратора"
                    Command="{Binding RestartAsAdminCommand}"
                    HorizontalAlignment="Left">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowAdminButton}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>
