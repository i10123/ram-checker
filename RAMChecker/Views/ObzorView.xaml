<UserControl x:Class="RAMChecker.Views.ObzorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,24,16,8">
            <TextBlock Text="Обзор" Style="{StaticResource Zagolovok}" />

            <!-- Без прав администратора драйвер недоступен: предлагаем перезапуск. -->
            <Border Style="{StaticResource Kartochka}" Visibility="{Binding NeedsAdministrator, Converter={StaticResource Vidimost}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Перезапустить от администратора" Command="{Binding AdministratorCommand}"
                            Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Тайминги и температура недоступны" FontWeight="SemiBold" />
                        <TextBlock Text="Для чтения паспорта SPD нужны права администратора." Style="{StaticResource Podpis}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Сводка по памяти системы. -->
            <UniformGrid Columns="4">
                <Border Style="{StaticResource Kartochka}">
                    <StackPanel>
                        <TextBlock Text="Всего памяти" Style="{StaticResource Podpis}" />
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource Chislo}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kartochka}">
                    <StackPanel>
                        <TextBlock Text="Используется" Style="{StaticResource Podpis}" />
                        <TextBlock Text="{Binding UsedText}" Style="{StaticResource Chislo}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kartochka}">
                    <StackPanel>
                        <TextBlock Text="Доступно" Style="{StaticResource Podpis}" />
                        <TextBlock Text="{Binding AvailableText}" Style="{StaticResource Chislo}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kartochka}">
                    <StackPanel>
                        <TextBlock Text="Модули" Style="{StaticResource Podpis}" />
                        <TextBlock Text="{Binding ModulesText}" Style="{StaticResource Chislo}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Паспорт выбранного модуля. -->
                <Border Style="{StaticResource Kartochka}">
                    <StackPanel>
                        <TextBlock Text="Модуль памяти" Style="{StaticResource Podzagolovok}" />
                        <ComboBox ItemsSource="{Binding ModulesMemory}" SelectedItem="{Binding SelectedModule}"
                                  DisplayMemberPath="DisplayName" Margin="0,0,0,12" HorizontalAlignment="Stretch" />
                        <ItemsControl ItemsSource="{Binding ModuleRows}" ItemTemplate="{StaticResource StrokaTablicy}" />
                        <TextBlock Text="{Binding SpdStatus}" Style="{StaticResource Podpis}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <!-- Как Windows распределяет память: эти данные не повторяют сводку сверху. -->
                    <Border Style="{StaticResource Kartochka}">
                        <StackPanel>
                            <TextBlock Text="Распределение памяти" Style="{StaticResource Podzagolovok}" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CommitText}" />
                                <TextBlock Text="Выделено программам" Style="{StaticResource Podpis}" />
                            </DockPanel>
                            <!-- Полоса без анимации: две колонки делят ширину пропорционально выделенной и свободной памяти. -->
                            <Grid Height="8" Margin="0,8,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding CommitUsed}" />
                                    <ColumnDefinition Width="{Binding CommitFree}" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4,0,0,4" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Border Grid.Column="1" CornerRadius="0,4,4,0" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding MemoryRows}" ItemTemplate="{StaticResource StrokaTablicy}" />
                        </StackPanel>
                    </Border>

                    <!-- Замер скорости: столбцы пропорциональны лучшему результату. -->
                    <Border Style="{StaticResource Kartochka}">
                        <StackPanel>
                            <TextBlock Text="Скорость памяти" Style="{StaticResource Podzagolovok}" />
                            <ItemsControl ItemsSource="{Binding BenchmarkBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="210" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Podpis}" />
                                            <Border Grid.Column="1" Width="{Binding Width}" Height="16" CornerRadius="4"
                                                    HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding BenchmarkText}" Margin="0,8,0,12" />
                            <Button Content="Измерить скорость" Command="{Binding BenchmarkCommand}" Style="{DynamicResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
