<UserControl x:Class="RAMChecker.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RAMChecker.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <Grid Margin="16,24,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="Результаты" Style="{StaticResource PageTitle}" />

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <TextBlock Text="Проверок пока нет. Запустите тест на вкладке «Тестирование»." Style="{StaticResource Caption}"
                           Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibility}}" />
                <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedResult}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Stripe" Width="4" CornerRadius="2" Margin="0,0,10,0" Background="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource StatusIcon}" Margin="0,2,10,0" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StartedText}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="1">
                                    <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="2">
                                    <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"
                Visibility="{Binding HasSelectedResult,Converter={StaticResource BoolToVisibility}}">
            <DockPanel DataContext="{Binding SelectedResult}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,4,0,16" />
                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Режим" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Mode}" Style="{StaticResource Number}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Длительность" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource Number}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Объём" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Number}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Проверено" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding CheckedText}" Style="{StaticResource Number}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Проходов" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Passes}" Style="{StaticResource Number}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Ошибок" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ErrorCount}" Style="{StaticResource Number}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding ConfigurationModules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                        BorderThickness="3,0,0,0" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Slot}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                        <TextBlock Text="{Binding Specs}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,16">
                        <Button Content="Сохранить отчёт" Click="Export_Click" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Удалить" Margin="8,0" Command="{Binding DataContext.DeleteResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Errors}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Смещение в буфере" Binding="{Binding OffsetText}" />
                        <DataGridTextColumn Header="Ожидалось" Binding="{Binding ExpectedText}" />
                        <DataGridTextColumn Header="Прочитано" Binding="{Binding ActualText}" />
                        <DataGridTextColumn Header="Шаг" Binding="{Binding Stage}" />
                        <DataGridTextColumn Header="Проход" Binding="{Binding Pass}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
