<UserControl x:Class="RAMChecker.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:RAMChecker.Helpers"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RAMChecker.Views"
             xmlns:vm="clr-namespace:RAMChecker.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <UserControl.Resources>
        <!-- Узкая полоса не отвлекает от результата, но остаётся заметной при наведении. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="4,4,2,4" />
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform X="12" /></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#14FFFFFF" CornerRadius="5" Padding="1">
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreasePage" Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" Background="Transparent">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" MinHeight="36">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#78FFFFFF" CornerRadius="4" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#A8FFFFFF" /></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBorder" Property="Background" Value="#D6FFFFFF" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreasePage" Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" Background="Transparent">
                                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="10" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="DecreasePage" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="IncreasePage" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                                <Setter TargetName="Thumb" Property="MinHeight" Value="0" />
                                <Setter TargetName="Thumb" Property="MinWidth" Value="36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,24,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="{DynamicResource UiResults}" Style="{StaticResource PageTitle}" />

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <TextBlock Text="{DynamicResource UiNoResultsYetStartATestOnTheTestingPage}" Style="{StaticResource Caption}"
                           Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVisibility}}" />
                <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedResult}" Background="Transparent" Padding="0,0,16,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Stripe" Width="4" CornerRadius="2" Margin="0,0,10,0" Background="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource StatusIcon}" Margin="0,2,10,0" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{ui:UiText StatusText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StartedText}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{ui:UiText Description}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="1">
                                    <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="2">
                                    <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"
                Visibility="{Binding HasSelectedResult,Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><DockPanel DataContext="{Binding SelectedResult}" Margin="0,0,16,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{ui:UiText StatusText}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{ui:UiText Recommendation}" TextWrapping="Wrap" Margin="0,4,0,16" />
                    <UniformGrid Columns="3" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource UiMode}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{ui:UiText Mode}" Style="{StaticResource Number}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource UiDuration}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding DurationText}" Style="{StaticResource Number}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource UiSize}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{ui:UiText MemoryText}" Style="{StaticResource Number}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource UiChecked}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{ui:UiText CheckedText}" Style="{StaticResource Number}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource UiPasses}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Passes}" Style="{StaticResource Number}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource UiErrors}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding ErrorCount}" Style="{StaticResource Number}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{ui:UiText Detail}" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource UiTestBufferMap}" Style="{StaticResource Caption}"/>
                    <ItemsControl ItemsSource="{Binding Cells}" Style="{StaticResource MemoryMap}" Margin="0,4,0,8"/>
                    <TextBlock Text="{DynamicResource UiPhysicalMemory}" Style="{StaticResource Caption}"/>
                    <local:SampleChart Samples="{Binding Samples}" Height="72"/>
                    <TextBlock Text="{DynamicResource UiCommittedMemoryOfLimit}" Style="{StaticResource Caption}"/>
                    <local:SampleChart Samples="{Binding Samples}" ShowCommit="True" Height="72"/>
                    <TextBlock Text="{ui:UiText SampleRange}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding ConfigurationModules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                        BorderThickness="3,0,0,0" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Slot}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2" />
                                        <TextBlock Text="{ui:UiText Specs}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,16">
                        <Button Content="{DynamicResource UiSaveReport}" Click="Export_Click" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="{DynamicResource UiDelete}" Margin="8,0" Command="{Binding DataContext.DeleteResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Errors}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource UiBufferOffset}" Binding="{Binding OffsetText}" />
                        <DataGridTextColumn Header="{DynamicResource UiExpected}" Binding="{Binding ExpectedText}" />
                        <DataGridTextColumn Header="{DynamicResource UiRead}" Binding="{Binding ActualText}" />
                        <DataGridTextColumn Header="{DynamicResource UiStage}" Binding="{ui:UiText Stage}" />
                        <DataGridTextColumn Header="{DynamicResource UiPass}" Binding="{Binding Pass}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel></ScrollViewer>
        </Border>
    </Grid>
</UserControl>
