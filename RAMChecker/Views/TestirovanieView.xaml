<UserControl x:Class="RAMChecker.Views.TestirovanieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,24,16,8">
            <TextBlock Text="Тестирование" Style="{StaticResource Zagolovok}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Параметры проверки. -->
                <StackPanel>
                    <Border Style="{StaticResource Kartochka}">
                        <StackPanel>
                            <TextBlock Text="Параметры" Style="{StaticResource Podzagolovok}" />
                            <TextBlock Text="Режим" Style="{StaticResource Podpis}" />
                            <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Stretch" Margin="0,4,0,16" />
                            <TextBlock Style="{StaticResource Podpis}">
                                <Run Text="Объём проверки:" />
                                <Run Text="{Binding TestMemoryText, Mode=OneWay}" />
                            </TextBlock>
                            <Slider IsEnabled="{Binding IsIdle}" Minimum="64" Maximum="{Binding MaxMemoryMiB, Mode=OneWay}" Value="{Binding MemoryMiB}"
                                    SmallChange="16" LargeChange="256" Margin="0,4,0,12" />
                            <CheckBox Content="Остановить при первой ошибке" IsChecked="{Binding StopOnError}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,16" />
                            <UniformGrid Columns="2">
                                <Button Content="Запустить" Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                                <Button Content="Остановить" Command="{Binding StopCommand}" HorizontalAlignment="Stretch" Margin="6,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Журнал: компактные строки, новые сверху. -->
                    <Border Style="{StaticResource Kartochka}">
                        <StackPanel>
                            <TextBlock Text="Журнал" Style="{StaticResource Podzagolovok}" />
                            <ScrollViewer Height="260" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Events}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="13" Margin="0,2" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <!-- Ход проверки. -->
                    <Border Style="{StaticResource Kartochka}">
                        <StackPanel>
                            <TextBlock Text="{Binding Stage}" Style="{StaticResource Podzagolovok}" />
                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="8" Margin="0,0,0,16" />
                            <UniformGrid Columns="4">
                                <StackPanel>
                                    <TextBlock Text="Прошло" Style="{StaticResource Podpis}" />
                                    <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Chislo}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Осталось" Style="{StaticResource Podpis}" />
                                    <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Chislo}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Проход" Style="{StaticResource Podpis}" />
                                    <TextBlock Text="{Binding PassText}" Style="{StaticResource Chislo}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Ошибок" Style="{StaticResource Podpis}" />
                                    <TextBlock Text="{Binding ErrorCountText}" Style="{StaticResource Chislo}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Kartochka}">
                        <StackPanel>
                            <TextBlock Text="Карта памяти" Style="{StaticResource Podzagolovok}" />
                            <ItemsControl ItemsSource="{Binding Kletki}" Style="{StaticResource KartaPamyati}" />
                            <TextBlock Text="Каждая клетка — 1/256 буфера. Яркая зелёная — блок прошёл текущий проход, тёмная — ждёт своей очереди, красная — найдены ошибки, серая — ещё не проверен."
                                       Style="{StaticResource Podpis}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Нагрузка во время проверки: скорость обработки буфера и загрузка памяти системы. -->
                    <Border Style="{StaticResource Kartochka}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Нагрузка" Style="{StaticResource Podzagolovok}" />
                                <TextBlock Text="Скорость проверки" Style="{StaticResource Podpis}" />
                                <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Chislo}" Margin="0,4,0,12" />
                                <TextBlock Text="Загрузка памяти" Style="{StaticResource Podpis}" />
                                <TextBlock Text="{Binding Obzor.LoadText}" Style="{StaticResource Chislo}" />
                            </StackPanel>
                            <ContentControl Grid.Column="1" Content="{Binding Obzor}" ContentTemplate="{StaticResource GrafikZagruzki}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
