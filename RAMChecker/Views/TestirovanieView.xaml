<UserControl x:Class="RAMChecker.Views.TestirovanieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,24,16,8">
            <TextBlock Text="Тестирование" Style="{StaticResource Zagolovok}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <!-- Параметры проверки. -->
                <Border Style="{StaticResource Kartochka}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Параметры" Style="{StaticResource Podzagolovok}" />
                        <TextBlock Text="Режим" Style="{StaticResource Podpis}" />
                        <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Stretch" Margin="0,4,0,16" />
                        <TextBlock Style="{StaticResource Podpis}">
                            <Run Text="Объём проверки:" />
                            <Run Text="{Binding TestMemoryText, Mode=OneWay}" />
                        </TextBlock>
                        <Slider IsEnabled="{Binding IsIdle}" Minimum="64" Maximum="{Binding MaxMemoryMiB, Mode=OneWay}" Value="{Binding MemoryMiB}"
                                SmallChange="16" LargeChange="256" Margin="0,4,0,16" />
                        <TextBlock Text="Алгоритм" Style="{StaticResource Podpis}" />
                        <TextBlock Text="{Binding Algorithm}" Margin="0,4,0,20" />
                        <UniformGrid Columns="2">
                            <Button Content="Запустить" Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                            <Button Content="Остановить" Command="{Binding StopCommand}" HorizontalAlignment="Stretch" Margin="6,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <!-- Ход проверки. -->
                    <Border Style="{StaticResource Kartochka}">
                        <StackPanel>
                            <TextBlock Text="{Binding Stage}" Style="{StaticResource Podzagolovok}" />
                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="8" Margin="0,0,0,16" />
                            <UniformGrid Columns="3">
                                <StackPanel>
                                    <TextBlock Text="Прошло" Style="{StaticResource Podpis}" />
                                    <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Chislo}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Проход" Style="{StaticResource Podpis}" />
                                    <TextBlock Text="{Binding PassText}" Style="{StaticResource Chislo}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Ошибок" Style="{StaticResource Podpis}" />
                                    <TextBlock Text="{Binding ErrorCountText}" Style="{StaticResource Chislo}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Kartochka}">
                        <StackPanel>
                            <TextBlock Text="Карта памяти" Style="{StaticResource Podzagolovok}" />
                            <ItemsControl ItemsSource="{Binding Map}" Style="{StaticResource KartaPamyati}" />
                            <TextBlock Text="Каждая клетка — 1/256 буфера. Зелёная — проверена, красная — найдены ошибки, серая — ожидает проверки."
                                       Style="{StaticResource Podpis}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Kartochka}">
                        <StackPanel>
                            <TextBlock Text="Журнал" Style="{StaticResource Podzagolovok}" />
                            <ListBox ItemsSource="{Binding Events}" Height="180" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
