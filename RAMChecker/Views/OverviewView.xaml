<UserControl x:Class="RAMChecker.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:RAMChecker.Helpers"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RAMChecker.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:OverviewViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="OverviewChart">
            <Grid Margin="0,4,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Percent" Text="{Binding LoadText}" FontSize="21" FontWeight="SemiBold"
                           Foreground="DeepSkyBlue" HorizontalAlignment="Right"/>
                <Grid Grid.Row="1" Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid Margin="0,0,6,0">
                        <TextBlock Text="100%" FontSize="12" VerticalAlignment="Top"/>
                        <TextBlock Text="50%" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="0%" FontSize="12" VerticalAlignment="Bottom"/>
                    </Grid>
                    <Viewbox Grid.Column="1" Stretch="Fill" Margin="0,7">
                        <Canvas Width="542" Height="102" ClipToBounds="True">
                            <Path Data="M0,0 H542 M0,51 H542 M0,102 H542" Stroke="{DynamicResource DividerStrokeColorDefaultBrush}"/>
                            <Polygon x:Name="Area" Canvas.Left="-58" Canvas.Top="-34" Points="{Binding UsageArea}" Fill="DeepSkyBlue" Opacity="0.12"/>
                            <Polyline x:Name="Line" Canvas.Left="-58" Canvas.Top="-34" Points="{Binding UsagePoints}" Stroke="DeepSkyBlue" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
                <TextBlock Grid.Row="2" Text="{DynamicResource UiLatestSamples}" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="Commit">
                    <Setter TargetName="Percent" Property="Text" Value="{Binding CommitPercentText}"/>
                    <Setter TargetName="Percent" Property="Foreground" Value="MediumAquamarine"/>
                    <Setter TargetName="Line" Property="Points" Value="{Binding CommitPoints}"/>
                    <Setter TargetName="Line" Property="Stroke" Value="MediumAquamarine"/>
                    <Setter TargetName="Area" Property="Points" Value="{Binding CommitArea}"/>
                    <Setter TargetName="Area" Property="Fill" Value="MediumAquamarine"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,24,16,8">
            <TextBlock Text="{DynamicResource UiOverview}" Style="{StaticResource PageTitle}" />

            <Border Style="{StaticResource Card}" Visibility="{Binding NeedsAdministrator, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{DynamicResource UiRestartAsAdministrator}" Command="{Binding AdministratorCommand}"
                            Style="{DynamicResource AccentButtonStyle}" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource UiMemoryTimingsUnavailable}" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource UiAdministratorAccessIsRequiredToReadSpd}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UiTotalMemory}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{ui:UiText TotalText}" Style="{StaticResource Number}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UiInUse}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{ui:UiText UsedText}" Style="{StaticResource Number}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UiAvailable}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{ui:UiText AvailableText}" Style="{StaticResource Number}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UiModules}" Style="{StaticResource Caption}" />
                        <TextBlock Text="{ui:UiText ModulesText}" Style="{StaticResource Number}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource UiLiveMonitoring}" Style="{StaticResource SectionTitle}"/>
                    <UniformGrid Columns="2">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource UiPhysicalMemory}" Style="{StaticResource Caption}"/>
                            <ContentControl Height="150" Content="{Binding}" ContentTemplate="{StaticResource OverviewChart}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource UiCommittedMemoryOfLimit}" Style="{StaticResource Caption}"/>
                            <ContentControl Height="150" Content="{Binding}" Tag="Commit" ContentTemplate="{StaticResource OverviewChart}"/>
                            <TextBlock Text="{ui:UiText CommitText}" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UiMemoryModule}" Style="{StaticResource SectionTitle}" />
                        <ComboBox ItemsSource="{Binding ModulesMemory}" SelectedItem="{Binding SelectedModule}"
                                  Margin="0,0,0,12" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{ui:UiText DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource UiReadingModuleInformation}" Style="{StaticResource Caption}"
                                   Visibility="{Binding Loading, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding ModuleRows}" ItemTemplate="{StaticResource TableRow}" />
                        <TextBlock Text="{ui:UiText SpdStatus}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource UiMemoryAllocation}" Style="{StaticResource SectionTitle}" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{ui:UiText CommitText}" />
                                <TextBlock Text="{DynamicResource UiCommittedMemory}" Style="{StaticResource Caption}" />
                            </DockPanel>
                            <Grid Height="8" Margin="0,8,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding CommitUsed}" />
                                    <ColumnDefinition Width="{Binding CommitFree}" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4,0,0,4" Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Border Grid.Column="1" CornerRadius="0,4,4,0" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding MemoryRows}" ItemTemplate="{StaticResource TableRow}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource UiMemoryPerformance}" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding BenchmarkBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Text="{ui:UiText Value}"/>
                                                <TextBlock Text="{ui:UiText Name}" Style="{StaticResource Caption}"/>
                                            </DockPanel>
                                            <ProgressBar Height="5" Margin="0,4,0,0" Minimum="0" Maximum="1"
                                                         Value="{Binding RelativeSpeed, Mode=OneWay}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{ui:UiText BenchmarkText}" Margin="0,8,0,12" />
                            <Button Content="{DynamicResource UiRunBenchmark}" Command="{Binding BenchmarkCommand}" Style="{DynamicResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
