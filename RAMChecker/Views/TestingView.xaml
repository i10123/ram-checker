<UserControl x:Class="RAMChecker.Views.TestingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:ui="clr-namespace:RAMChecker.Helpers"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RAMChecker.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:TestingViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,24,16,8">
            <TextBlock Text="{DynamicResource UiTesting}" Style="{StaticResource PageTitle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource UiParameters}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource UiMode}" Style="{StaticResource Caption}" />
                            <ComboBox SelectedIndex="{Binding ModeIndex}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Stretch" Margin="0,4,0,16">
                                <ComboBoxItem Content="{DynamicResource UiQuick10Minutes}"/>
                                <ComboBoxItem Content="{DynamicResource UiFull2Hours}"/>
                                <ComboBoxItem Content="{DynamicResource UiContinuousUntilStopped}"/>
                                <ComboBoxItem Content="{DynamicResource UiStressAllAvailableMemory}"/>
                            </ComboBox>
                            <TextBlock Style="{StaticResource Caption}">
                                <Run Text="{DynamicResource UiTestSize}" />
                                <Run Text="{ui:UiText TestMemoryText}" />
                            </TextBlock>
                            <Slider IsEnabled="{Binding IsIdle}" Minimum="64" Maximum="{Binding MaxMemoryMiB, Mode=OneWay}" Value="{Binding MemoryMiB}"
                                    SmallChange="16" LargeChange="256" Margin="0,4,0,12" />
                            <TextBlock Text="{DynamicResource UiInsufficientFreeMemoryWindowsNeedsAtLeast1GbOr10OfRamInReser}"
                                       Visibility="{Binding MemoryShort, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,0,0,12" />
                            <CheckBox Content="{DynamicResource UiStopOnFirstError}" IsChecked="{Binding StopOnError}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,16" />
                            <UniformGrid Columns="2">
                                <Button Content="{DynamicResource UiStart}" Command="{Binding StartCommand}" Style="{DynamicResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                                <Button Content="{DynamicResource UiStop}" Command="{Binding StopCommand}" HorizontalAlignment="Stretch" Margin="6,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <ContentControl Content="{Binding LastResult}" Visibility="{Binding HasLastResult, Converter={StaticResource BoolToVisibility}}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Border x:Name="Banner" CornerRadius="8" Padding="20,16" Margin="0,0,16,16"
                                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource StatusIcon}" FontSize="28" Margin="0,0,16,0" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="{ui:UiText StatusText}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{ui:UiText Recommendation}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="1">
                                        <Setter TargetName="Banner" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="2">
                                        <Setter TargetName="Banner" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{ui:UiText Stage}" Style="{StaticResource SectionTitle}" />
                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="8" Margin="0,0,0,16" />
                            <UniformGrid Columns="4">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource UiElapsed}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Number}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource UiRemaining}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding RemainingText}" Style="{StaticResource Number}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource UiPass}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding PassText}" Style="{StaticResource Number}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource UiErrors}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding ErrorCountText}" Style="{StaticResource Number}" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource UiTestBufferMap}" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Cells}" Style="{StaticResource MemoryMap}" />
                            <TextBlock Text="{DynamicResource UiEachCellRepresents1256OfTheBufferBrightGreenIndicatesAComple}"
                                       Style="{StaticResource Caption}" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource UiLoad}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{DynamicResource UiTestThroughput}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{ui:UiText SpeedText}" Style="{StaticResource Number}" Margin="0,4,0,12" />
                                <TextBlock Text="{DynamicResource UiMemoryUsage}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Overview.LoadText}" Style="{StaticResource Number}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource UiPhysicalMemory}" Style="{StaticResource Caption}"/>
                                <ContentControl Height="64" Content="{Binding Overview}" ContentTemplate="{StaticResource LoadChart}"/>
                                <TextBlock Text="{DynamicResource UiCommittedMemoryOfLimit}" Style="{StaticResource Caption}"/>
                                <Viewbox Height="64" Stretch="Fill"><Canvas Width="600" Height="160">
                                    <Polyline Points="{Binding Overview.CommitPoints}" StrokeThickness="3" Stroke="{DynamicResource AccentFillColorDefaultBrush}"/>
                                </Canvas></Viewbox>
                                <TextBlock Text="{DynamicResource UiMemoryClockMclk}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Overview.ClockText}"/>
                                <Viewbox Height="50" Stretch="Fill"><Canvas Width="600" Height="160">
                                    <Polyline Points="{Binding Overview.ClockPoints}" StrokeThickness="3" Stroke="{DynamicResource AccentFillColorDefaultBrush}"/>
                                </Canvas></Viewbox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
