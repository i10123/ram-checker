<UserControl x:Class="RAMChecker.Views.RezultatyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,24,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="Результаты" Style="{StaticResource Zagolovok}" />

        <!-- История проверок. -->
        <Border Grid.Row="1" Style="{StaticResource Kartochka}">
            <Grid>
                <TextBlock Text="Проверок пока нет. Запустите тест на вкладке «Тестирование»." Style="{StaticResource Podpis}"
                           Visibility="{Binding HasNoHistory, Converter={StaticResource Vidimost}}" />
                <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedResult}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StartedText}" Style="{StaticResource Podpis}" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Podpis}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Подробности выбранной проверки. -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Kartochka}"
                Visibility="{Binding HasHistory, Converter={StaticResource Vidimost}}">
            <DockPanel DataContext="{Binding SelectedResult}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Podpis}" Margin="0,4,0,12" />
                    <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Podpis}" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding Map}" Style="{StaticResource KartaPamyati}" Margin="0,16" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Сохранить HTML" Tag="html" Click="Export_Click" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Сохранить CSV" Tag="csv" Click="Export_Click" Margin="8,0" />
                        <Button Content="Печать / PDF" Tag="pdf" Click="Export_Click" />
                    </StackPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Errors}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Visibility="{Binding HasErrors, Converter={StaticResource Vidimost}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Смещение" Binding="{Binding OffsetText}" />
                        <DataGridTextColumn Header="Ожидалось" Binding="{Binding ExpectedText}" />
                        <DataGridTextColumn Header="Прочитано" Binding="{Binding ActualText}" />
                        <DataGridTextColumn Header="Шаг" Binding="{Binding Stage}" />
                        <DataGridTextColumn Header="Проход" Binding="{Binding Pass}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
