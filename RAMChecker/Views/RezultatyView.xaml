<UserControl x:Class="RAMChecker.Views.RezultatyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,24,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="Результаты" Style="{StaticResource Zagolovok}" />

        <!-- История проверок. -->
        <Border Grid.Row="1" Style="{StaticResource Kartochka}">
            <Grid>
                <TextBlock Text="Проверок пока нет. Запустите тест на вкладке «Тестирование»." Style="{StaticResource Podpis}"
                           Visibility="{Binding HasNoHistory, Converter={StaticResource Vidimost}}" />
                <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding SelectedResult}" Background="Transparent">
                    <ListBox.ItemTemplate>
                        <!-- Цветная полоска и значок: зелёный — без ошибок, красный — ошибки, жёлтый — не завершена. -->
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Polosa" Width="4" CornerRadius="2" Margin="0,0,10,0" Background="{DynamicResource SystemFillColorCautionBrush}" />
                                <TextBlock x:Name="Znachok" Grid.Column="1" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="16" Margin="0,2,10,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StartedText}" Style="{StaticResource Podpis}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Podpis}" />
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Uroven}" Value="1">
                                    <Setter TargetName="Polosa" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Setter TargetName="Znachok" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Setter TargetName="Znachok" Property="Text" Value="&#xE73E;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Uroven}" Value="2">
                                    <Setter TargetName="Polosa" Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter TargetName="Znachok" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter TargetName="Znachok" Property="Text" Value="&#xEA39;" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Подробности выбранной проверки. -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Kartochka}"
                Visibility="{Binding HasHistory, Converter={StaticResource Vidimost}}">
            <DockPanel DataContext="{Binding SelectedResult}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Podpis}" Margin="0,4,0,12" />
                    <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Podpis}" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding Kletki}" Style="{StaticResource KartaPamyati}" Margin="0,16" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Сохранить отчёт" Click="Export_Click" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Удалить" Margin="8,0" Command="{Binding DataContext.DeleteResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Errors}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Visibility="{Binding HasErrors, Converter={StaticResource Vidimost}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Смещение" Binding="{Binding OffsetText}" />
                        <DataGridTextColumn Header="Ожидалось" Binding="{Binding ExpectedText}" />
                        <DataGridTextColumn Header="Прочитано" Binding="{Binding ActualText}" />
                        <DataGridTextColumn Header="Шаг" Binding="{Binding Stage}" />
                        <DataGridTextColumn Header="Проход" Binding="{Binding Pass}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
