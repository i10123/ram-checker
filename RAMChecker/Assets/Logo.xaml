<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Логотип: планка памяти на градиентном квадрате 64 × 64. Из него же собрана иконка logo.ico. -->
    <DrawingImage x:Key="Logo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M14,0 H50 A14,14 0 0 1 64,14 V50 A14,14 0 0 1 50,64 H14 A14,14 0 0 1 0,50 V14 A14,14 0 0 1 14,0 Z">
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C5CFF" Offset="0" />
                            <GradientStop Color="#22B8F0" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                </GeometryDrawing>
                <!-- Плата модуля и контакты с вырезом-ключом посередине. -->
                <GeometryDrawing Brush="White"
                                 Geometry="M12,19 H52 A2,2 0 0 1 54,21 V40 H10 V21 A2,2 0 0 1 12,19 Z
                                           M12,40 h2 v6 h-2 Z M16,40 h2 v6 h-2 Z M20,40 h2 v6 h-2 Z M24,40 h2 v6 h-2 Z M28,40 h2 v6 h-2 Z
                                           M34,40 h2 v6 h-2 Z M38,40 h2 v6 h-2 Z M42,40 h2 v6 h-2 Z M46,40 h2 v6 h-2 Z M50,40 h2 v6 h-2 Z" />
                <!-- Микросхемы памяти. -->
                <GeometryDrawing Brush="#5A48D8"
                                 Geometry="M14,24 h7 v11 h-7 Z M23.5,24 h7 v11 h-7 Z M33.5,24 h7 v11 h-7 Z M43,24 h7 v11 h-7 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
